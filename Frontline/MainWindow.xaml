<Window x:Class="FrontLineOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrontLine Lyrics" Height="300" Width="700" MinWidth="450" MinHeight="200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
           <!-- Halo behind the lyrics: dark glow (ShadowDepth=0) for readability over
               light content when the overlay floats. Contribution by Warith Adetayo. -->
        <Style x:Key="LyricHalo" TargetType="TextBlock">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" Margin="0,0,0,4" FontSize="9" FontWeight="Bold"/>
                            <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" HorizontalAlignment="Center" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#AAAAAA" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4D7A53E4"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#907A53E4"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchNoLabelStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="#33FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#AAAAAA" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4D7A53E4"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#907A53E4"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkipGlyph" TargetType="Rectangle">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Fill" Value="#E0E0E0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="MenuGlyph" TargetType="Rectangle">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Fill" Value="#E0E0E0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F2141418"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#3AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#55FFFFFF" CornerRadius="4" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A07A53E4"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C47A53E4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkScrollRepeat" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="10" Background="Transparent">
                <Border Background="#14FFFFFF" CornerRadius="5" Margin="2,4"/>
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource DarkScrollRepeat}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource DarkScrollThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource DarkScrollRepeat}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="10" Background="Transparent">
                <Border Background="#14FFFFFF" CornerRadius="5" Margin="4,2"/>
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource DarkScrollRepeat}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource DarkScrollThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource DarkScrollRepeat}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#55FFFFFF"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="MinWidth" Value="10"/>
                    <Setter Property="Height" Value="Auto"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkComboToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MaxDropDownHeight" Value="132"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#EEEEEE"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#337A53E4"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#4D7A53E4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                      HorizontalAlignment="Left" RecognizesAccessKey="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                    <TextBlock Grid.Column="1" Text="▾" Foreground="#88FFFFFF" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton Style="{StaticResource DarkComboToggle}" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Margin="0,6,0,0" Background="#FF141418" BorderBrush="#3AFFFFFF" BorderThickness="1"
                                        CornerRadius="10" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True" CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#287A53E4"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#667A53E4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageOverlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" Opacity="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VersionLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="TxtVersionLabel" Text="{TemplateBinding Content}" Foreground="#88FFFFFF" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TxtVersionLabel" Property="Foreground" Value="#DDDDDD"/>
                                <Setter TargetName="TxtVersionLabel" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FestivalGlassButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="BorderBrush" Value="#667A53E4"/>
        </Style>

        <Style x:Key="GlassToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#4D7A53E4"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#907A53E4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="Foreground" Value="#AAFFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SquareGlassButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FestivalSquareButton" TargetType="Button" BasedOn="{StaticResource SquareGlassButton}">
            <Setter Property="BorderBrush" Value="#887A53E4"/>
        </Style>

        <Style x:Key="SquareGlassToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BgBorder" Property="Background" Value="#4D7A53E4"/>
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="#907A53E4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopWindowBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoberToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderFillRepeatButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="#7A53E4" CornerRadius="2" Height="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderEmptyRepeatButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassSliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="ThumbEllipse" Width="14" Height="14" Fill="White" Stroke="#7A53E4" StrokeThickness="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbEllipse" Property="Fill" Value="#7A53E4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassSlider" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#22FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFillRepeatButton}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderEmptyRepeatButton}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GlassSliderThumb}" Width="14" Height="14" Cursor="Hand"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Border x:Name="MainBorder" Background="#FF0A0A0A" CornerRadius="12" Padding="20" BorderBrush="#22FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35*" x:Name="SidePanelCol"/>
                    <ColumnDefinition Width="65*" x:Name="ContentPanelCol"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="SidePanel" Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Viewbox Grid.Row="0" Stretch="Uniform" Margin="0,0,0,12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="130" Height="130" CornerRadius="8" ClipToBounds="True" Background="#11FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                            <Image x:Name="AlbumCoverImg" Stretch="UniformToFill" />
                        </Border>
                    </Viewbox>
                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                        <TextBlock x:Name="LblSongTitle" Foreground="#E0E0E0" FontSize="13" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,2" Visibility="Collapsed"/>
                        <TextBlock x:Name="LblArtistName" Text="Ready." Foreground="#888888" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock x:Name="LblTranslating" Text="Translating..." Foreground="#A955FF" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,0" HorizontalAlignment="Center" Visibility="Collapsed"/>

                        <StackPanel x:Name="DonateBlock"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0"
                                    Visibility="{Binding Visibility, ElementName=HomeControls}">
                            <Button x:Name="BtnDonate"
                                    Style="{StaticResource ImageOverlayButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Click="BtnDonate_Click">
                                <StackPanel HorizontalAlignment="Center" Width="150">
                                    <TextBlock x:Name="TxtDonateLabel" Foreground="#CCCCCC" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <Image x:Name="ImgDonateButton" Width="150" Height="40" Stretch="Uniform" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ContentPanel" Grid.Column="1" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="LyricsNormalView" Grid.Column="0" IsHitTestVisible="False">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LblPrevious" Style="{StaticResource LyricHalo}" Foreground="#555555" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock x:Name="LblCurrent" Style="{StaticResource LyricHalo}" Foreground="#FFCC33" FontSize="26" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="LblCurrentOriginal" Style="{StaticResource LyricHalo}" Foreground="#99FFFFFF" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="LblNext" Style="{StaticResource LyricHalo}" Foreground="#555555" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="FestivalAdvanceView" Grid.Column="0" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock x:Name="LblFestivalAdvanceHint" Foreground="#88FFFFFF" FontSize="11" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,12"/>
                            <Border x:Name="BandFestivalAdvance" CornerRadius="10" Padding="18,16" Background="#CC050508">
                                <StackPanel>
                                    <TextBlock x:Name="LblFestivalAdvanceSong" Foreground="#FFCC33" FontSize="22" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LblFestivalAdvanceArtist" Foreground="#CCFFFFFF" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnFestivalAdvance" Style="{StaticResource FestivalGlassButton}" HorizontalAlignment="Center"
                                    Margin="0,16,0,0" Padding="22,10" MinWidth="160" Click="BtnFestivalAdvance_Click"/>
                        </StackPanel>

                        <ListBox x:Name="FullLyricsList" Grid.Column="0" Visibility="Collapsed" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Hidden" HorizontalContentAlignment="Stretch" SelectionChanged="FullLyricsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource LyricHalo}" Foreground="#AAAAAA" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" Padding="0,8" Cursor="Hand"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <Grid x:Name="LoadingSpinner" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel>
                                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                    <Ellipse Width="40" Height="40" Stroke="#22FFFFFF" StrokeThickness="3"/>

                                    <!-- Arco animado com Branco Forte -->
                                    <Ellipse x:Name="ListenArc" Width="40" Height="40"
                                            Stroke="White" StrokeThickness="3"
                                            StrokeDashArray="39 39" StrokeDashOffset="39"
                                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="ListenArcSpin" Angle="0"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>


                                </Grid>

                                <TextBlock x:Name="LblLoadingText" Text="Listening..." Foreground="White" FontSize="11" FontWeight="Bold" Margin="0,12,0,0" HorizontalAlignment="Center">
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                             From="0.3" To="1.0" Duration="0:0:1.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="FestivalLineSkip" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed">
                            <Button x:Name="BtnFestivalPrevLine" Style="{StaticResource FestivalSquareButton}" Padding="8,8" MinWidth="32" Click="BtnFestivalPrevLine_Click">
                                <Rectangle x:Name="ImgFestivalLineUp" Style="{StaticResource SkipGlyph}"/>
                            </Button>
                            <Button x:Name="BtnFestivalNextLine" Style="{StaticResource FestivalSquareButton}" Padding="8,8" MinWidth="32" Margin="0,6,0,0" Click="BtnFestivalNextLine_Click">
                                <Rectangle x:Name="ImgFestivalLineDown" Style="{StaticResource SkipGlyph}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PlayingControls" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="PlayingControlsNormal" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnPrevTrack" Style="{StaticResource SquareGlassButton}" Padding="10,8" MinWidth="36" Margin="0,0,6,0" Click="BtnPrevTrack_Click">
                                <Rectangle x:Name="ImgPrevTrack" Style="{StaticResource SkipGlyph}"/>
                            </Button>
                            <Button x:Name="BtnListenSide" Style="{StaticResource SquareGlassButton}" Padding="12,6" FontSize="10" Margin="0,0,6,0" Click="BtnListen_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle x:Name="IcoListenSide" Style="{StaticResource MenuGlyph}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtListenSide" Text="LISTEN" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <ToggleButton x:Name="BtnAutoSide" Content="AUTO" Style="{StaticResource ToggleSwitchStyle}" Click="BtnAuto_Click" Margin="0,0,10,0"/>
                            <Button x:Name="BtnResetSide" Style="{StaticResource SquareGlassButton}" Padding="12,6" FontSize="10" Click="BtnReset_Click">
                                <TextBlock x:Name="TxtResetSide" Text="CLEAR" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnSearchSide" Style="{StaticResource SquareGlassButton}" Padding="10,6" FontSize="12" Margin="6,0,6,0" Click="BtnSearchShow_Click">
                                <Rectangle x:Name="IcoSearchSide" Style="{StaticResource MenuGlyph}" Margin="0"/>
                            </Button>
                            <Button x:Name="BtnNextTrack" Style="{StaticResource SquareGlassButton}" Padding="10,8" MinWidth="36" Click="BtnNextTrack_Click">
                                <Rectangle x:Name="ImgNextTrack" Style="{StaticResource SkipGlyph}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="PlayingControlsFestival" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Button x:Name="BtnFestivalPrevTrack" Style="{StaticResource SquareGlassButton}" Padding="10,8" MinWidth="36" Margin="0,0,6,0" Click="BtnFestivalPrevTrack_Click">
                                <Rectangle x:Name="ImgFestivalPrevTrack" Style="{StaticResource SkipGlyph}"/>
                            </Button>
                            <Button x:Name="BtnFestivalEdit" Style="{StaticResource FestivalSquareButton}" Padding="12,6" FontSize="10" Margin="0,0,6,0" Click="BtnFestivalEdit_Click">
                                <TextBlock x:Name="TxtFestivalEdit" Text="EDIT SETLIST" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnFestivalStop" Style="{StaticResource SquareGlassButton}" Padding="12,6" FontSize="10" Margin="0,0,6,0" Click="BtnFestivalStop_Click">
                                <TextBlock x:Name="TxtFestivalStop" Text="STOP FESTIVAL" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="BtnFestivalSearch" Style="{StaticResource SquareGlassButton}" Padding="10,6" FontSize="12" Margin="0,0,6,0" Click="BtnSearchShow_Click">
                                <Rectangle x:Name="IcoFestivalSearch" Style="{StaticResource MenuGlyph}" Margin="0"/>
                            </Button>
                            <Button x:Name="BtnFestivalNextTrack" Style="{StaticResource SquareGlassButton}" Padding="10,8" MinWidth="36" Click="BtnFestivalNextTrack_Click">
                                <Rectangle x:Name="ImgFestivalNextTrack" Style="{StaticResource SkipGlyph}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Viewbox x:Name="HomeControls" Grid.RowSpan="2" Visibility="Visible" StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0">
                        <Border Background="#FA0A0A0A" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="25" Padding="15,8">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnReleaseNotes" Margin="5,0,16,0" Click="BtnReleaseNotes_Click" ToolTip="See what's new in this version"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtAppName" Text="FRONTLINE LYRICS" Foreground="#88FFFFFF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TxtAppVersion" Text="v1.2.1" Foreground="#88FFFFFF" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TxtAppName" Property="Foreground" Value="#DDDDDD"/>
                                                    <Setter TargetName="TxtAppVersion" Property="Foreground" Value="#DDDDDD"/>
                                                    <Setter TargetName="TxtAppName" Property="TextDecorations" Value="Underline"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="BtnListenBig" Style="{StaticResource GlassButton}" Margin="0,0,8,0" Click="BtnListen_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle x:Name="IcoListenBig" Style="{StaticResource MenuGlyph}"/>
                                        <TextBlock x:Name="TxtListenBig" Text="LISTEN" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnSearchBig" Style="{StaticResource GlassButton}" Margin="0,0,8,0" Click="BtnSearchShow_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle x:Name="IcoSearchBig" Style="{StaticResource MenuGlyph}"/>
                                        <TextBlock x:Name="TxtSearchBig" Text="SEARCH" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnFestivalBig" Style="{StaticResource FestivalGlassButton}" Margin="0,0,12,0" Click="BtnFestival_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle x:Name="IcoFestivalBig" Style="{StaticResource MenuGlyph}"/>
                                        <TextBlock x:Name="TxtFestivalBig" Text="FESTIVAL" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Rectangle Width="1" Fill="#33FFFFFF" Margin="0,5,12,5"/>
                                <Button x:Name="BtnHelpHome" Style="{StaticResource GlassButton}" Width="36" Height="36" Padding="0" Click="BtnStartHelp_Click">
                                    <Rectangle x:Name="IcoHelpHome" Style="{StaticResource MenuGlyph}" Margin="0"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Viewbox>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="SearchInputPanel" Visibility="Collapsed" Background="#F2050505" ClipToBounds="True">
            <Border x:Name="SearchContentBorder" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Margin="16,42,16,16" Background="#FF0A0A0A" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.38*" MinWidth="180"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="0.62*" MinWidth="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock x:Name="LblManualSearchTitle" Text="MANUAL SEARCH" Foreground="#888" FontSize="10" Margin="0,0,0,16" FontWeight="Bold"/>

                        <TextBlock x:Name="LblArtistSearch" Text="Artist:" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtArtist" Background="#111" Foreground="White" BorderBrush="#333" Margin="0,0,0,10" Padding="6" KeyDown="TxtSearch_KeyDown"/>

                        <TextBlock x:Name="LblSongSearch" Text="Song:" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtSong" Background="#111" Foreground="White" BorderBrush="#333" Margin="0,0,0,16" Padding="6" KeyDown="TxtSearch_KeyDown"/>

                        <Button x:Name="BtnFindSearch" Content="FIND" Style="{StaticResource GlassButton}" Click="BtnManualSearch_Execute"/>
                        <Button x:Name="BtnCancelSearch" Visibility="Collapsed" Click="BtnSearchCancel_Click"/>
                    </StackPanel>

                    <Rectangle Grid.Column="1" Width="1" Fill="#22FFFFFF" HorizontalAlignment="Center"/>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LblSearchHistoryTitle" Text="SEARCH HISTORY" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ListView x:Name="SearchHistoryList" Grid.Row="1"
                                  Background="Transparent" BorderThickness="0" Foreground="#E0E0E0"
                                  FontSize="12" SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  GridViewColumnHeader.Click="HistoryHeader_Click"
                                  PreviewMouseLeftButtonUp="HistoryList_PreviewMouseLeftButtonUp">
                            <ListView.Resources>
                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource HistoryHeader}"/>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#E0E0E0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,2"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#18FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#287A53E4"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn x:Name="ColHistoryArtist" Header="Artist" Width="140" DisplayMemberBinding="{Binding Artist}"/>
                                    <GridViewColumn x:Name="ColHistorySong" Header="Song" Width="160" DisplayMemberBinding="{Binding Song}"/>
                                    <GridViewColumn x:Name="ColHistoryDate" Header="Date" Width="130" DisplayMemberBinding="{Binding DateLabel}"/>
                                    <GridViewColumn x:Name="ColHistoryDelete" Header="" Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Width="28" Height="24" Padding="0" FontSize="10"
                                                        Style="{StaticResource SquareGlassButton}"
                                                        Click="BtnHistoryDelete_Click"
                                                        ToolTip="Remove"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="LblSearchHistoryEmpty" Grid.Row="1" Text="No searches yet."
                                   Foreground="#66FFFFFF" FontSize="12" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="FestivalHubPanel" Visibility="Collapsed" Background="#F2050505" ClipToBounds="True">
            <Border x:Name="FestivalContentBorder" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Margin="16,42,16,16" Background="#FF0A0A0A" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.38*" MinWidth="170"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="0.62*" MinWidth="180"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock x:Name="LblFestivalTitle" Text="FESTIVAL MODE" Foreground="#888" FontSize="10" Margin="0,0,0,10" FontWeight="Bold"/>
                        <TextBlock x:Name="LblFestivalIntro" Text="At live shows, Shazam often fails. Load a setlist, preload lyrics, then tap the first line when the singer starts."
                                   Foreground="#CCFFFFFF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="18"/>

                        <TextBlock x:Name="LblFestivalApiKey" Text="setlist.fm API key" Foreground="#888" FontSize="10" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TxtFestivalApiKey" Background="#111" Foreground="White" BorderBrush="#333" Padding="6" Margin="0,0,0,6"
                                     PasswordChanged="TxtFestivalApiKey_PasswordChanged"/>
                        <TextBlock x:Name="LblFestivalApiKeyState" Text="" Foreground="#66FFFFFF" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <Button x:Name="BtnFestivalSaveKey" Content="SAVE KEY" Style="{StaticResource SquareGlassButton}" Padding="10,6" FontSize="10" HorizontalAlignment="Left" Margin="0,0,0,10" Click="BtnFestivalSaveKey_Click"/>
                        <TextBlock>
                            <Hyperlink x:Name="LnkFestivalApi" NavigateUri="https://www.setlist.fm/settings/api" RequestNavigate="FestivalApiLink_Click" Foreground="#A955FF">
                                <Run x:Name="TxtFestivalApiLink" Text="Get a free API key"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <Rectangle Grid.Column="1" Width="1" Fill="#22FFFFFF" HorizontalAlignment="Center"/>

                    <Grid Grid.Column="2" x:Name="FestivalListView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="LblFestivalPlaylists" Text="SAVED SETLISTS" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock x:Name="LblFestivalNewArtist" Text="Artist or band" Foreground="#888" FontSize="10" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFestivalArtist" Background="#111" Foreground="White" BorderBrush="#333" Padding="6"
                                         KeyDown="TxtFestivalArtist_KeyDown"/>
                                <Button x:Name="BtnFestivalCreate" Grid.Column="1" Content="CREATE" Style="{StaticResource FestivalSquareButton}"
                                        Padding="12,6" FontSize="10" Margin="8,0,0,0" Click="BtnFestivalCreate_Click"/>
                            </Grid>
                            <Grid x:Name="FestivalSearchFilters" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock x:Name="LblFestivalSearchCountry" Text="Country (optional)" Foreground="#66FFFFFF" FontSize="9" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtFestivalCountry" Background="#111" Foreground="White" BorderBrush="#333" Padding="5"
                                             KeyDown="TxtFestivalArtist_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                    <TextBlock x:Name="LblFestivalSearchVenue" Text="Venue (optional)" Foreground="#66FFFFFF" FontSize="9" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtFestivalVenue" Background="#111" Foreground="White" BorderBrush="#333" Padding="5"
                                             KeyDown="TxtFestivalArtist_KeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="LblFestivalSearchYear" Text="Year (optional)" Foreground="#66FFFFFF" FontSize="9" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtFestivalYear" Background="#111" Foreground="White" BorderBrush="#333" Padding="5"
                                             MaxLength="4" KeyDown="TxtFestivalArtist_KeyDown"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="LblFestivalFetchStatus" Text="" Foreground="#A955FF" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid Grid.Row="2" x:Name="FestivalSearchResultsPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="LblFestivalSearchResults" Text="RECENT SETLISTS" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="LblFestivalNoResults" Grid.Row="1" Text="" Foreground="#99FFFFFF" FontSize="12"
                                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6"/>
                            <ListBox x:Name="FestivalSetlistSearchList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                     MaxHeight="140" HorizontalContentAlignment="Stretch"
                                     SelectionChanged="FestivalSetlistSearchList_SelectionChanged"
                                     MouseDoubleClick="BtnFestivalCreateFromResult_Click">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Title}" Foreground="#E0E0E0" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Meta}" Foreground="#88FFFFFF" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="6,5"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#287A53E4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <Button x:Name="BtnFestivalCreateFromResult" Grid.Row="2" Content="CREATE PLAYLIST" Style="{StaticResource FestivalGlassButton}"
                                    Margin="0,8,0,0" Visibility="Collapsed" Click="BtnFestivalCreateFromResult_Click"/>
                        </Grid>

                        <Grid Grid.Row="3">
                            <ListBox x:Name="FestivalPlaylistList" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch"
                                     MouseDoubleClick="FestivalPlaylistList_MouseDoubleClick"
                                     PreviewMouseLeftButtonUp="FestivalPlaylistList_PreviewMouseLeftButtonUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Foreground="#E0E0E0" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Meta}" Foreground="#88FFFFFF" FontSize="10" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✕" Width="28" Height="24" Padding="0" FontSize="10"
                                                    Style="{StaticResource SquareGlassButton}"
                                                    Click="BtnFestivalDeletePlaylist_Click"
                                                    ToolTip="Delete"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#287A53E4"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <TextBlock x:Name="LblFestivalEmpty" Text="No setlists yet. Enter an artist to create one."
                                       Foreground="#66FFFFFF" FontSize="12" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="2" x:Name="FestivalEditorView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="LblFestivalEditorTitle" Text="SETLIST" Foreground="#888" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtFestivalPlaylistName" Background="#111" Foreground="White" BorderBrush="#333" Padding="6"
                                     LostFocus="TxtFestivalPlaylistName_LostFocus"/>
                        </StackPanel>

                        <Grid x:Name="FestivalSongListHost" Grid.Row="1">
                            <ListBox x:Name="FestivalSongList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="FestivalSongList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="FestivalSongList_PreviewMouseMove"
                                 GiveFeedback="FestivalSongList_GiveFeedback"
                                 DragOver="FestivalSongList_DragOver"
                                 PreviewDrop="FestivalSongList_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2" Background="Transparent" Cursor="SizeAll">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="⋮⋮" Foreground="#55FFFFFF" FontSize="13" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Song}" Foreground="#E0E0E0" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist}" Foreground="#88FFFFFF" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="✕" Width="28" Height="24" Padding="0" FontSize="10" Cursor="Hand"
                                                Style="{StaticResource SquareGlassButton}" Click="BtnFestivalSongDelete_Click" ToolTip="Remove"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="AllowDrop" Value="True"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                        <Setter Property="Cursor" Value="SizeAll"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="FestivalDropCue" Height="3" Width="1" CornerRadius="2"
                                    Background="#E07A53E4" Visibility="Collapsed"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            </Canvas>
                            <TextBlock x:Name="LblFestivalSongsEmpty" Text="Empty setlist. Add songs below or search during the show."
                                   Foreground="#66FFFFFF" FontSize="12" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblFestivalAddArtist" Grid.Column="0" Text="Artist" Foreground="#888" FontSize="10" Margin="0,0,6,4"/>
                                <TextBlock x:Name="LblFestivalAddSong" Grid.Column="1" Text="Song" Foreground="#888" FontSize="10" Margin="0,0,6,4"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFestivalAddArtist" Grid.Column="0" Background="#111" Foreground="White" BorderBrush="#333" Padding="6" Margin="0,0,6,0" KeyDown="TxtFestivalAdd_KeyDown"/>
                                <TextBox x:Name="TxtFestivalAddSong" Grid.Column="1" Background="#111" Foreground="White" BorderBrush="#333" Padding="6" Margin="0,0,6,0" KeyDown="TxtFestivalAdd_KeyDown"/>
                                <Button x:Name="BtnFestivalAddSong" Grid.Column="2" Content="ADD" Style="{StaticResource FestivalSquareButton}" Padding="12,6" FontSize="10" Click="BtnFestivalAddSong_Click"/>
                            </Grid>
                        </Grid>

                        <Button x:Name="BtnFestivalStart" Grid.Row="3" Content="START" Style="{StaticResource FestivalGlassButton}"
                                HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="BtnFestivalStart_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Thumb x:Name="ResizeGrip" Panel.ZIndex="40" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragStarted="ResizeGrip_DragStarted" DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 16,4 L 4,16 M 16,9 L 9,16 M 16,14 L 14,16" Stroke="#555555" StrokeThickness="2"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Button x:Name="BtnOverlayBack" Panel.ZIndex="41" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8,8,0,0" Width="32" Height="32" Style="{StaticResource TopWindowBtn}"
                Visibility="Collapsed" Click="BtnOverlayBack_Click">
            <Rectangle x:Name="ImgOverlayBack" Style="{StaticResource SkipGlyph}"/>
        </Button>

        <StackPanel x:Name="TopRightControls" Panel.ZIndex="40" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
            <ToggleButton x:Name="BtnMenu" Content="⋮" Width="30" Height="30" Style="{StaticResource SoberToggle}" Cursor="Hand" FontSize="18" FontWeight="Bold"/>
            <Button x:Name="BtnMinimize" Content="—" Width="30" Height="30" Style="{StaticResource TopWindowBtn}" FontSize="12" FontWeight="Bold" Click="BtnMinimize_Click"/>
            <Button x:Name="BtnRestore" Content="❐" Width="30" Height="30" Style="{StaticResource TopWindowBtn}" FontSize="14" Visibility="Collapsed" Click="BtnRestore_Click"/>
            <Button x:Name="BtnCloseTop" Content="✕" Width="30" Height="30" Style="{StaticResource TopWindowBtn}" FontSize="12" FontWeight="Bold" Click="BtnExit_Click"/>
        </StackPanel>

        <Popup x:Name="SettingsPopup" IsOpen="{Binding IsChecked, ElementName=BtnMenu}" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnMenu}" Placement="Bottom" HorizontalOffset="-190" VerticalOffset="10" AllowsTransparency="True" Closed="SettingsPopup_Closed">
            <Border x:Name="MenuScaleBorder" Background="#FF0A0A0A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="15" Width="230">
                <StackPanel>
                    <TextBlock x:Name="LblSettingsTitle" Text="SETTINGS" Foreground="#66FFFFFF" FontSize="9" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                    <StackPanel x:Name="SettingsExtras">
                        <Button x:Name="BtnManualSyncToggle" Content="MANUAL SYNC" Style="{StaticResource SquareGlassButton}" Padding="0,6" Margin="0,0,0,15" Click="BtnManualSync_Toggle" Visibility="Collapsed"/>
                        <TextBlock x:Name="LblTranslateTitle" Text="TRANSLATE LYRICS" Foreground="#66FFFFFF" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                        <UniformGrid Columns="3" Margin="0,0,0,15">
                            <ToggleButton x:Name="TransOriginal" Content="Orig" Style="{StaticResource SquareGlassToggle}" FontSize="10" Click="BtnTrans_Click" Tag="original" Margin="2" IsChecked="True"/>
                            <ToggleButton x:Name="TransRomanized" Content="Rom" Style="{StaticResource SquareGlassToggle}" FontSize="10" Click="BtnTrans_Click" Tag="romanized" Margin="2"/>
                            <ToggleButton x:Name="TransEn" Content="EN" Style="{StaticResource SquareGlassToggle}" FontSize="10" Click="BtnTrans_Click" Tag="en" Margin="2"/>
                            <ToggleButton x:Name="TransEs" Content="ES" Style="{StaticResource SquareGlassToggle}" FontSize="10" Click="BtnTrans_Click" Tag="es" Margin="2"/>
                            <ToggleButton x:Name="TransFr" Content="FR" Style="{StaticResource SquareGlassToggle}" FontSize="10" Click="BtnTrans_Click" Tag="fr" Margin="2"/>
                            <ToggleButton x:Name="TransPt" Content="PT" Style="{StaticResource SquareGlassToggle}" FontSize="10" Click="BtnTrans_Click" Tag="pt" Margin="2"/>
                        </UniformGrid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblKeepOriginal" Text="Também mostra a letra original" Foreground="#99FFFFFF" FontSize="9" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ToggleButton x:Name="ChkKeepOriginal" Grid.Column="1" Style="{StaticResource ToggleSwitchNoLabelStyle}" Click="ChkKeepOriginal_Click" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="LblFontSizeTitle" Text="TAMANHO DA FONTE" Foreground="#66FFFFFF" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SldFontSize" Style="{StaticResource GlassSlider}" Minimum="14" Maximum="80" Value="26" VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="SldFontSize_ValueChanged"/>
                            <Button Grid.Column="1" Content="↺" Style="{StaticResource SquareGlassButton}" Width="24" Height="24" Padding="0" FontSize="12" Click="BtnResetFont_Click"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="LblBgOpacityTitle" Text="OPACIDADE DO FUNDO" Foreground="#66FFFFFF" FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Slider x:Name="SldBgOpacity" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1" Value="0.8" Margin="0,0,0,12" ValueChanged="SldBgOpacity_ValueChanged"/>

                    <StackPanel x:Name="SettingsExtras2">
                        <TextBlock x:Name="LblAppLangTitle" Text="APP LANGUAGE" Foreground="#66FFFFFF" FontSize="9" FontWeight="Bold" Margin="0,10,0,8"/>
                        <ComboBox x:Name="CmbAppLang" Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="CmbAppLang_SelectionChanged"
                                  DropDownOpened="CmbAppLang_DropDownOpened"
                                  DropDownClosed="CmbAppLang_DropDownClosed">
                            <ComboBoxItem Tag="en" Content="English"/>
                            <ComboBoxItem Tag="pt" Content="Português"/>
                            <ComboBoxItem Tag="es" Content="Español"/>
                            <ComboBoxItem Tag="id" Content="Bahasa Indonesia"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Border x:Name="OpacityPreviewOverlay" Panel.ZIndex="45" Visibility="Collapsed" CornerRadius="12" IsHitTestVisible="False">
            <Grid Margin="20">
                <TextBlock x:Name="LblPreviewTag" Text="PREVIEW" Foreground="#33FFFFFF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LblPreviewPrevious" Style="{StaticResource LyricHalo}" Foreground="#777777" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LblPreviewCurrent" Style="{StaticResource LyricHalo}" Foreground="#FFCC33" FontSize="26" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LblPreviewCurrentOriginal" Style="{StaticResource LyricHalo}" Foreground="#B3FFFFFF" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="LblPreviewNext" Style="{StaticResource LyricHalo}" Foreground="#777777" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="DarkDialogOverlay" Panel.ZIndex="90" Visibility="Collapsed" Background="#CC050508"
              Focusable="True" PreviewKeyDown="DarkDialogOverlay_PreviewKeyDown">
            <Border Background="#FF141418" BorderBrush="#3AFFFFFF" BorderThickness="1" CornerRadius="14"
                    Padding="22" MaxWidth="360" MinWidth="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="LblDarkDialogTitle" Foreground="#EEEEEE" FontSize="14" FontWeight="Bold"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LblDarkDialogBody" Foreground="#CCFFFFFF" FontSize="13"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnDarkDialogNo" Style="{StaticResource SquareGlassButton}" MinWidth="88" Height="32"
                                Padding="12,6" Margin="0,0,8,0" Click="BtnDarkDialogNo_Click"/>
                        <Button x:Name="BtnDarkDialogYes" Style="{StaticResource FestivalGlassButton}" MinWidth="88" Height="32"
                                Padding="12,6" Click="BtnDarkDialogYes_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
