    <Grid>
        <Path Data="M0,34 C50,8 100,46 170,22 C240,0 300,42 380,20 C450,2 510,40 600,16 L600,86 L0,86 Z" Fill="#222B63" Opacity="0.8" Stretch="Fill" Height="46" VerticalAlignment="Bottom"/>
