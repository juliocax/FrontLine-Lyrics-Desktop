            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F2DC8E" Offset="0"/>
                    <GradientStop Color="#B8912F" Offset="0.45"/>
                    <GradientStop Color="#5E4614" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#FFE9A8" Opacity="0.9" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="60,0,0,26"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#FFFFFF" Opacity="0.8" Stretch="Uniform" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="-120,0,0,30"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#FFE9A8" Opacity="0.85" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="110,0,0,28"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#FFFFFF" Opacity="0.8" Stretch="Uniform" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,90,26"/>
        <Ellipse Width="3" Height="3" Fill="#E26BD0" Opacity="0.8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="150,0,0,34"/>
        <Ellipse Width="3" Height="3" Fill="#6BC8E2" Opacity="0.8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,0,36"/>
        <Ellipse Width="3" Height="3" Fill="#F2DC8E" Opacity="0.9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,200,32"/>
        <Ellipse Width="2.5" Height="2.5" Fill="#FFFFFF" Opacity="0.8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="260,0,0,30"/>
