<UserControl x:Class="FrontLineOverlay.SantaLogoAdorn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="False" IsHitTestVisible="False">

    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/Themes/Seasonal/ChristmasResources.xaml"/>
    </UserControl.Resources>

    <Canvas Width="1000" Height="1000" ClipToBounds="False">

        <!-- Cor da logo: gradiente de presente, recortado pelo canal alfa da própria logo.
             A imagem oculta só dá a altura correta (mesma proporção da logo). -->
        <Grid x:Name="LogoTintLayer" Canvas.Left="0" Canvas.Top="0" Width="1000" IsHitTestVisible="False">
            <Image x:Name="LogoSizer" Visibility="Hidden" Stretch="Uniform"/>
            <Rectangle Fill="{StaticResource Xmas.GiftBrush}">
                <Rectangle.OpacityMask>
                    <ImageBrush x:Name="LogoTintMask" Stretch="Fill"/>
                </Rectangle.OpacityMask>
            </Rectangle>
        </Grid>

        <Canvas Canvas.Left="703" Canvas.Top="23" Width="300" Height="260">
            <Canvas.RenderTransform>
                <RotateTransform Angle="14" CenterX="150" CenterY="130"/>
            </Canvas.RenderTransform>

            <Path Data="M20,210 C30,100 110,30 200,20 C250,15 290,40 300,90 C250,70 230,120 260,210 Z" RenderTransformOrigin="0.5,0.5" Canvas.Left="-185.084" Canvas.Top="-34.658" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="6.734"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Path.RenderTransform>
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFE53935" Offset="0"/>
                        <GradientStop Color="#FFA3141A" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <Ellipse Canvas.Left="84" Canvas.Top="43" Width="76" Height="76" Fill="#FFFAFAFA" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Border Canvas.Left="-192" Canvas.Top="151" Width="266" Height="48" CornerRadius="30" Background="#FFFAFAFA" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="3.628"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Border.RenderTransform>
            </Border>
        </Canvas>
    </Canvas>
</UserControl>
