            </Path.RenderTransform>
        </Path>
        <Path x:Name="SeasonSnow8" Data="{StaticResource SnowflakeGeometry}" Fill="#FFFFFF" Opacity="0" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,20,0" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="24"/>
                    <TranslateTransform x:Name="SeasonSnowY8" Y="0"/>
                </TransformGroup>
            </Path.RenderTransform>
        </Path>
        <Path Data="{StaticResource SnowflakeGeometry}" Fill="#FFFFFF" Opacity="0.3" Stretch="Uniform" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,78,140,0" RenderTransformOrigin="0.5,0.5">
        </Path>
        <Path x:Name="SeasonSnow10" Data="{StaticResource SnowflakeGeometry}" Fill="#FFFFFF" Opacity="0" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="150,-60,0,0" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="30"/>
                    <TranslateTransform x:Name="SeasonSnowY10" Y="0"/>
                </TransformGroup>
            </Path.RenderTransform>
        </Path>
        <Viewbox Width="176" Height="228" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Stretch="Uniform" Opacity="0.58" IsHitTestVisible="False">
            <Canvas Width="180" Height="230">
                <Path Data="M90.0,46.0 L122.0,96.0 L58.0,96.0 Z" Fill="#2E9A52"/>
                <Path Data="M90.0,46.0 L109.8,74.0 L90.0,63.4 L70.2,74.0 Z" Fill="#F4F8FF"/>
                <Path Data="M90.0,82.0 L140.0,146.0 L40.0,146.0 Z" Fill="#26864A"/>
                <Path Data="M90.0,82.0 L121.0,118.0 L90.0,104.3 L59.0,118.0 Z" Fill="#F4F8FF"/>
                <Path Data="M90.0,128.0 L160.0,206.0 L20.0,206.0 Z" Fill="#1F7040"/>
                <Path Data="M90.0,128.0 L133.4,170.0 L90.0,154.0 L46.6,170.0 Z" Fill="#F4F8FF"/>
                <Rectangle Canvas.Left="82" Canvas.Top="198" Width="16" Height="26" Fill="#6E4A28"/>
                <Path Data="M90.0,8.0 L93.5,17.1 L103.3,17.7 L95.7,23.9 L98.2,33.3 L90.0,28.0 L81.8,33.3 L84.3,23.9 L76.7,17.7 L86.5,17.1 Z" Fill="#F0C85A"/>
                <Ellipse Canvas.Left="76" Canvas.Top="88" Width="12" Height="12" Fill="#D64545"/>
                <Ellipse Canvas.Left="104" Canvas.Top="118" Width="12" Height="12" Fill="#E0B03A"/>
                <Ellipse Canvas.Left="64" Canvas.Top="164" Width="14" Height="14" Fill="#4C86D1"/>
                <Ellipse Canvas.Left="112" Canvas.Top="168" Width="14" Height="14" Fill="#D64545"/>
                <Ellipse Canvas.Left="84" Canvas.Top="176" Width="12" Height="12" Fill="#E0B03A"/>
            </Canvas>
        </Viewbox>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnowY1" Storyboard.TargetProperty="Y" BeginTime="0:0:0" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:11" Value="22"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnow1" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:1.65" Value="0.55"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:8.8" Value="0.39"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:11" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnowY3" Storyboard.TargetProperty="Y" BeginTime="0:0:2.4" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:13" Value="18"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnow3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:2.4" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:1.95" Value="0.35"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:10.4" Value="0.24"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:13" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnowY4" Storyboard.TargetProperty="Y" BeginTime="0:0:1.2" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:9" Value="14"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnow4" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.2" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:1.35" Value="0.4"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:7.2" Value="0.28"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:9" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnowY5" Storyboard.TargetProperty="Y" BeginTime="0:0:3.5" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:12" Value="20"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnow5" Storyboard.TargetProperty="Opacity" BeginTime="0:0:3.5" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="0.45"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:9.6" Value="0.32"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:12" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnowY7" Storyboard.TargetProperty="Y" BeginTime="0:0:0.6" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:10" Value="16"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnow7" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.6" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.5"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:8.0" Value="0.35"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:10" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnowY8" Storyboard.TargetProperty="Y" BeginTime="0:0:4.2" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:14" Value="18"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnow8" Storyboard.TargetProperty="Opacity" BeginTime="0:0:4.2" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="0.35"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:11.2" Value="0.24"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:14" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnowY10" Storyboard.TargetProperty="Y" BeginTime="0:0:2.0" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:11" Value="15"/>
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SeasonSnow10" Storyboard.TargetProperty="Opacity" BeginTime="0:0:2.0" RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:1.65" Value="0.28"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:8.8" Value="0.2"/>
                            <LinearDoubleKeyFrame KeyTime="0:0:11" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
    </Grid>
</UserControl>
