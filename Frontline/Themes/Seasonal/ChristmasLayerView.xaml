<UserControl x:Class="FrontLineOverlay.ChristmasLayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/SeasonalResources.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Seasonal/ChristmasResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ===== Fundo noturno + estrelas (originais preservadas) ===== -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#66101830" Offset="0"/>
                    <GradientStop Color="#00080C18" Offset="0.7"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Ellipse Width="2.6" Height="2.6" Fill="#F7FBFF" Opacity="0.75" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,20,0,0"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#F7FBFF" Opacity="0.8" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,48,0,0"/>
        <Ellipse Width="2.2" Height="2.2" Fill="#F7FBFF" Opacity="0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110,16,0,0"/>
        <Ellipse Width="3" Height="3" Fill="#F7FBFF" Opacity="0.6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,70,0,0"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#F7FBFF" Opacity="0.55" Stretch="Uniform" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,120,0,0"/>
        <Ellipse Width="2.4" Height="2.4" Fill="#F7FBFF" Opacity="0.45" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="200,34,0,0"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#F7FBFF" Opacity="0.85" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-80,14,0,0"/>
        <Ellipse Width="2.4" Height="2.4" Fill="#F7FBFF" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10,28,0,0"/>
        <Ellipse Width="3.2" Height="3.2" Fill="#F7FBFF" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="70,12,0,0"/>
        <Ellipse Width="2" Height="2" Fill="#F7FBFF" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-20,48,0,0"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#F7FBFF" Opacity="0.7" Stretch="Uniform" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="140,22,0,0"/>
        <Ellipse Width="2.6" Height="2.6" Fill="#F7FBFF" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="200,40,0,0"/>
        <Ellipse Width="3" Height="3" Fill="#F7FBFF" Opacity="0.65" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,40,0"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#F7FBFF" Opacity="0.8" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,36,110,0"/>
        <Ellipse Width="2.2" Height="2.2" Fill="#F7FBFF" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,70,0"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#F7FBFF" Opacity="0.55" Stretch="Uniform" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,88,160,0"/>
        <Ellipse Width="2.4" Height="2.4" Fill="#F7FBFF" Opacity="0.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,200,0"/>
        <Ellipse Width="2.2" Height="2.2" Fill="#F7FBFF" Opacity="0.35" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,-40,0,0"/>
        <Ellipse Width="2.6" Height="2.6" Fill="#F7FBFF" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-60,24,0"/>
        <Ellipse Width="2" Height="2" Fill="#F7FBFF" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-160,-70,0,0"/>
        <Ellipse Width="3" Height="3" Fill="#F7FBFF" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,-80,0,0"/>
        <Ellipse Width="2.2" Height="2.2" Fill="#F7FBFF" Opacity="0.35" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="240,100,0,0"/>
        <Ellipse Width="2.4" Height="2.4" Fill="#F7FBFF" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,130,0"/>
        <Ellipse Width="2" Height="2" Fill="#F7FBFF" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-140,8,0,0"/>
        <Ellipse Width="2.8" Height="2.8" Fill="#F7FBFF" Opacity="0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="300,18,0,0"/>
        <Ellipse Width="2" Height="2" Fill="#F7FBFF" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,280,0"/>

        <!-- ===== Neve caindo (animada em ChristmasLayerView.xaml.cs) ===== -->
        <Canvas x:Name="SnowCanvas" ClipToBounds="True" IsHitTestVisible="False">
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.04 16 0.1 6" Width="3.0" Height="3.0" Opacity="0.7"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.11 22 0.55 8" Width="2.2" Height="2.2" Opacity="0.45"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.17 18 0.8 5" Width="4.0" Height="4.0" Opacity="0.6"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.24 26 0.3 9" Width="2.6" Height="2.6" Opacity="0.5"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.31 20 0.65 6" Width="3.4" Height="3.4" Opacity="0.55"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.38 24 0.05 8" Width="2.0" Height="2.0" Opacity="0.4"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.45 17 0.45 5" Width="4.4" Height="4.4" Opacity="0.75"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.52 28 0.9 10" Width="2.4" Height="2.4" Opacity="0.45"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.58 19 0.2 6" Width="3.0" Height="3.0" Opacity="0.6"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.65 23 0.7 7" Width="2.2" Height="2.2" Opacity="0.4"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.72 15 0.35 5" Width="4.6" Height="4.6" Opacity="0.75"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.79 25 0.6 9" Width="2.6" Height="2.6" Opacity="0.5"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.85 21 0.15 6" Width="3.2" Height="3.2" Opacity="0.6"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.91 27 0.85 8" Width="2.0" Height="2.0" Opacity="0.4"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.96 18 0.5 5" Width="3.6" Height="3.6" Opacity="0.65"/>
            <Ellipse Style="{StaticResource Xmas.Flake}" Tag="0.28 30 0.75 10" Width="2.0" Height="2.0" Opacity="0.35"/>
            <Path Style="{StaticResource Xmas.Crystal}" Data="{StaticResource SnowflakeGeometry}" Tag="0.08 30 0.4 10" Width="12" Height="12" Opacity="0.55"/>
            <Path Style="{StaticResource Xmas.Crystal}" Data="{StaticResource SnowflakeGeometry}" Tag="0.35 34 0.1 12" Width="10" Height="10" Opacity="0.45"/>
            <Path Style="{StaticResource Xmas.Crystal}" Data="{StaticResource SnowflakeGeometry}" Tag="0.55 32 0.7 10" Width="14" Height="14" Opacity="0.6"/>
            <Path Style="{StaticResource Xmas.Crystal}" Data="{StaticResource SnowflakeGeometry}" Tag="0.74 36 0.25 12" Width="11" Height="11" Opacity="0.5"/>
            <Path Style="{StaticResource Xmas.Crystal}" Data="{StaticResource SnowflakeGeometry}" Tag="0.93 31 0.55 9" Width="13" Height="13" Opacity="0.55"/>
        </Canvas>

        <!-- ===== Árvore minimalista (flat), apoiada no chão de neve ===== -->
        <Viewbox Width="120" Height="153" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,18,10" Stretch="Uniform" IsHitTestVisible="False">
            <Canvas Width="180" Height="230">
                <!-- montinho de neve na base -->
                <Ellipse Canvas.Left="52" Canvas.Top="214" Width="76" Height="14" Fill="{StaticResource Xmas.SnowBrush}"/>
                <!-- tronco -->
                <Rectangle Canvas.Left="81" Canvas.Top="198" Width="18" Height="24" Fill="{StaticResource Xmas.TrunkBrush}"/>
                <!-- copas: 4 triângulos sobrepostos (de baixo para cima) -->
                <Path Data="M90,134 L152,200 L28,200 Z" Fill="{StaticResource Xmas.PineDarkBrush}"/>
                <Path Data="M90,134 L114.8,160.4 L103,157 L90,166 L77,157 L65.2,160.4 Z" Fill="{StaticResource Xmas.SnowBrush}"/>
                <Path Data="M90,96 L140,156 L40,156 Z" Fill="{StaticResource Xmas.PineBrush}"/>
                <Path Data="M90,96 L110,120 L101,117 L90,124 L79,117 L70,120 Z" Fill="{StaticResource Xmas.SnowBrush}"/>
                <Path Data="M90,62 L128,114 L52,114 Z" Fill="{StaticResource Xmas.PineLightBrush}"/>
                <Path Data="M90,62 L105.2,82.8 L98,80 L90,86 L82,80 L74.8,82.8 Z" Fill="{StaticResource Xmas.SnowBrush}"/>
                <Path Data="M90,34 L118,78 L62,78 Z" Fill="{StaticResource Xmas.PineBrush}"/>
                <Path Data="M90,34 L102.6,53.8 L96,51 L90,56 L84,51 L77.4,53.8 Z" Fill="{StaticResource Xmas.SnowBrush}"/>
                <!-- estrela dourada -->
                <Path Data="M90.0,8.0 L93.5,17.1 L103.3,17.7 L95.7,23.9 L98.2,33.3 L90.0,28.0 L81.8,33.3 L84.3,23.9 L76.7,17.7 L86.5,17.1 Z" Fill="{StaticResource Xmas.GoldBrush}"/>
                <!-- bolas vermelhas e douradas -->
                <Ellipse Canvas.Left="68"  Canvas.Top="92"  Width="12" Height="12" Fill="{StaticResource Xmas.RedBrush}"/>
                <Ellipse Canvas.Left="98"  Canvas.Top="98"  Width="12" Height="12" Fill="{StaticResource Xmas.GoldBrush}"/>
                <Ellipse Canvas.Left="102" Canvas.Top="136" Width="12" Height="12" Fill="{StaticResource Xmas.RedBrush}"/>
                <Ellipse Canvas.Left="64"  Canvas.Top="140" Width="12" Height="12" Fill="{StaticResource Xmas.GoldBrush}"/>
                <Ellipse Canvas.Left="53"  Canvas.Top="179" Width="14" Height="14" Fill="{StaticResource Xmas.RedBrush}"/>
                <Ellipse Canvas.Left="82"  Canvas.Top="172" Width="12" Height="12" Fill="{StaticResource Xmas.GoldBrush}"/>
                <Ellipse Canvas.Left="111" Canvas.Top="181" Width="14" Height="14" Fill="{StaticResource Xmas.RedBrush}"/>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
