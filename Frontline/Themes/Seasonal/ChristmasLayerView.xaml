        <Ellipse Width="3.2" Height="3.2" Fill="#F7FBFF" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="70,12,0,0"/>
        <Ellipse Width="2" Height="2" Fill="#F7FBFF" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-20,48,0,0"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#F7FBFF" Opacity="0.7" Stretch="Uniform" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="140,22,0,0"/>
        <Ellipse Width="2.6" Height="2.6" Fill="#F7FBFF" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="200,40,0,0"/>
        <Ellipse Width="3" Height="3" Fill="#F7FBFF" Opacity="0.65" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,40,0"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#F7FBFF" Opacity="0.8" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,36,110,0"/>
        <Ellipse Width="2.2" Height="2.2" Fill="#F7FBFF" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,64,70,0"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#F7FBFF" Opacity="0.55" Stretch="Uniform" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,88,160,0"/>
        <Ellipse Width="2.4" Height="2.4" Fill="#F7FBFF" Opacity="0.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,200,0"/>
        <Ellipse Width="2.2" Height="2.2" Fill="#F7FBFF" Opacity="0.35" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,-40,0,0"/>
        <Ellipse Width="2.6" Height="2.6" Fill="#F7FBFF" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-60,24,0"/>
        <Ellipse Width="2" Height="2" Fill="#F7FBFF" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-160,-70,0,0"/>
        <Ellipse Width="3" Height="3" Fill="#F7FBFF" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,-80,0,0"/>
        <Ellipse Width="2.2" Height="2.2" Fill="#F7FBFF" Opacity="0.35" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="240,100,0,0"/>
        <Ellipse Width="2.4" Height="2.4" Fill="#F7FBFF" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,120,130,0"/>
        <Ellipse Width="2" Height="2" Fill="#F7FBFF" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-140,8,0,0"/>
        <Ellipse Width="2.8" Height="2.8" Fill="#F7FBFF" Opacity="0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="300,18,0,0"/>
        <Ellipse Width="2" Height="2" Fill="#F7FBFF" Opacity="0.45" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,280,0"/>
        <Path x:Name="SeasonSnow1" Data="{StaticResource SnowflakeGeometry}" Fill="#FFFFFF" Opacity="0" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,40,0,0" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="10"/>
                    <TranslateTransform x:Name="SeasonSnowY1" Y="0"/>
                </TransformGroup>
            </Path.RenderTransform>
        </Path>
        <Path Data="{StaticResource SnowflakeGeometry}" Fill="#FFFFFF" Opacity="0.4" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,16,0,0" RenderTransformOrigin="0.5,0.5">
        </Path>
        <Path x:Name="SeasonSnow3" Data="{StaticResource SnowflakeGeometry}" Fill="#FFFFFF" Opacity="0" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="20"/>
                    <TranslateTransform x:Name="SeasonSnowY3" Y="0"/>
                </TransformGroup>
            </Path.RenderTransform>
        </Path>
        <Path x:Name="SeasonSnow4" Data="{StaticResource SnowflakeGeometry}" Fill="#FFFFFF" Opacity="0" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,70" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="-12"/>
                    <TranslateTransform x:Name="SeasonSnowY4" Y="0"/>
                </TransformGroup>
            </Path.RenderTransform>
        </Path>
        <Path x:Name="SeasonSnow5" Data="{StaticResource SnowflakeGeometry}" Fill="#FFFFFF" Opacity="0" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-60,20,0,0" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="16"/>
                    <TranslateTransform x:Name="SeasonSnowY5" Y="0"/>
                </TransformGroup>
            </Path.RenderTransform>
        </Path>
        <Path Data="{StaticResource SnowflakeGeometry}" Fill="#FFFFFF" Opacity="0.32" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="80,8,0,0" RenderTransformOrigin="0.5,0.5">
        </Path>
        <Path x:Name="SeasonSnow7" Data="{StaticResource SnowflakeGeometry}" Fill="#FFFFFF" Opacity="0" Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,48,0" RenderTransformOrigin="0.5,0.5">
