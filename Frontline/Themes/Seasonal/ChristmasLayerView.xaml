<UserControl x:Class="FrontLineOverlay.ChristmasLayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/Styles/SeasonalResources.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#66101830" Offset="0"/>
                    <GradientStop Color="#00080C18" Offset="0.7"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Ellipse Width="2.6" Height="2.6" Fill="#F7FBFF" Opacity="0.75" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,20,0,0"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#F7FBFF" Opacity="0.8" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,48,0,0"/>
        <Ellipse Width="2.2" Height="2.2" Fill="#F7FBFF" Opacity="0.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110,16,0,0"/>
        <Ellipse Width="3" Height="3" Fill="#F7FBFF" Opacity="0.6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,70,0,0"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#F7FBFF" Opacity="0.55" Stretch="Uniform" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,120,0,0"/>
        <Ellipse Width="2.4" Height="2.4" Fill="#F7FBFF" Opacity="0.45" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="200,34,0,0"/>
        <Path Data="{StaticResource SparkleGeometry}" Fill="#F7FBFF" Opacity="0.85" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-80,14,0,0"/>
