<UserControl x:Class="FrontLineOverlay.ChristmasGroundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">

    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/Themes/Seasonal/ChristmasResources.xaml"/>
    </UserControl.Resources>

    <Grid>
        <!-- 1. traseira: azul acinzentado -->
        <Path Style="{StaticResource Xmas.Hill}" Data="{StaticResource Xmas.HillBack}"
              Fill="{StaticResource Xmas.FrostBrush}" Height="48"/>
        <!-- 2. intermediária: azul muito claro -->
        <Path Style="{StaticResource Xmas.Hill}" Data="{StaticResource Xmas.HillMid}"
              Fill="{StaticResource Xmas.IceBrush}" Height="40"/>
        <!-- 3. frontal: branca -->
        <Path Style="{StaticResource Xmas.Hill}" Data="{StaticResource Xmas.HillFront}"
              Fill="{StaticResource Xmas.SnowBrush}" Height="32"/>
    </Grid>
</UserControl>
