<UserControl x:Class="FrontLineOverlay.GoldVinylGroundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="po">
    <UserControl.Resources>
        <RadialGradientBrush x:Key="DiscBrush" po:Freeze="True">
            <GradientStop Color="#FF241B11" Offset="0"/>
            <GradientStop Color="#FF17110A" Offset="0.55"/>
            <GradientStop Color="#FF0C0905" Offset="0.92"/>
            <GradientStop Color="#FF020201" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="LabelBrush" GradientOrigin="0.4,0.35" po:Freeze="True">
            <GradientStop Color="#FFFAE7A0" Offset="0"/>
            <GradientStop Color="#FFDDB044" Offset="0.55"/>
            <GradientStop Color="#FF9C6F17" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="SheenBrush" MappingMode="Absolute" Center="100,100" GradientOrigin="100,100" RadiusX="100" RadiusY="100" po:Freeze="True">
            <GradientStop Color="#00FFF1C2" Offset="0"/>
            <GradientStop Color="#00FFF1C2" Offset="0.34"/>
            <GradientStop Color="#2AFFF1C2" Offset="0.55"/>
            <GradientStop Color="#70FFF1C2" Offset="1"/>
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="HaloBrush" po:Freeze="True">
            <GradientStop Color="#00FFC83C" Offset="0"/>
            <GradientStop Color="#00FFC83C" Offset="0.62"/>
            <GradientStop Color="#38FFC83C" Offset="0.78"/>
            <GradientStop Color="#00FFC83C" Offset="1"/>
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0A0703" Offset="0"/>
                <GradientStop Color="#FF181006" Offset="0.5"/>
                <GradientStop Color="#FF090603" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="DiscRot" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:24" RepeatBehavior="Forever"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Rectangle CacheMode="BitmapCache">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.6" RadiusY="0.75">
                    <GradientStop Color="#38FFC83C" Offset="0"/>
                    <GradientStop Color="#00FFC83C" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="30">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:6" AutoReverse="True" RepeatBehavior="Forever" AccelerationRatio="0.5" DecelerationRatio="0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Rectangle.Triggers>
        </Rectangle>

