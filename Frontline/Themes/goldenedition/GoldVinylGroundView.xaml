                    <Canvas Width="200" Height="200" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="DiscRot"/>
                        </Canvas.RenderTransform>

                        <Path Stroke="#88000000" StrokeThickness="1.4">
                            <Path.Data>
                                <GeometryGroup>
                                    <EllipseGeometry Center="100,100" RadiusX="52" RadiusY="52"/>
