<UserControl x:Class="FrontLineOverlay.MainStageLayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="po"
             IsHitTestVisible="False">
    <UserControl.Resources>
        
    </UserControl.Resources>

    <Grid IsHitTestVisible="False" ClipToBounds="True">
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush RadiusX="0.75" RadiusY="0.8">
                    <GradientStop Color="#00000000" Offset="0.55"/>
                    <GradientStop Color="#AA5A0008" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.65" To="1" Duration="0:0:5" AutoReverse="True" RepeatBehavior="Forever" AccelerationRatio="0.5" DecelerationRatio="0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Rectangle.Triggers>
        </Rectangle>

        <Border BorderThickness="1.5" BorderBrush="#99B0121C" Margin="14" IsHitTestVisible="False"/>


        <Viewbox Stretch="Uniform" MaxHeight="90" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,18,0,0" Opacity="0" IsHitTestVisible="False">
            <Canvas Width="60" Height="100">
                <Polygon Points="36,0 12,52 30,52 8,100 54,40 36,40 56,0" Fill="#FFFFE6E6" Stroke="#FFFF2A2A" StrokeThickness="2.5" StrokeLineJoin="Round"/>
            </Canvas>
            <Viewbox.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:8" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:6" Value="0.9"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:6.1" Value="0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:6.25" Value="0.7"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:6.4" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Viewbox.Triggers>
        </Viewbox>
        <Viewbox Stretch="Uniform" MaxHeight="90" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,12,0" Opacity="0" IsHitTestVisible="False">
            <Canvas Width="60" Height="100">
                <Polygon Points="36,0 12,52 30,52 8,100 54,40 36,40 56,0" Fill="#FFFFE6E6" Stroke="#FFFF2A2A" StrokeThickness="2.5" StrokeLineJoin="Round"/>
            </Canvas>
            <Viewbox.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:11" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2" Value="0.9"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2.1" Value="0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2.25" Value="0.7"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:2.4" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Viewbox.Triggers>
        </Viewbox>
    </Grid>
</UserControl>