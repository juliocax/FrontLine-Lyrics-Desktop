<UserControl x:Class="FrontLineOverlay.MainStageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="po">
    <UserControl.Resources>
        <PathGeometry x:Key="BodyGeo" Figures="M57,170 L26,126 C22,160 30,185 36,200 L30,214 C18,225 14,262 34,276 C50,290 80,290 96,276 C116,262 112,225 100,214 L94,200 C100,185 108,160 104,126 L73,170 Z"/>

        <LinearGradientBrush x:Key="BodyBrush" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#FF3A050C" Offset="0"/>
            <GradientStop Color="#FF160308" Offset="1"/>
        </LinearGradientBrush>

        <Canvas x:Key="GuitarArt" x:Shared="False" Width="130" Height="300">
            <Ellipse Canvas.Left="-26" Canvas.Top="110" Width="182" Height="190">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#30C0121C" Offset="0"/>
                        <GradientStop Color="#00C0121C" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="-5" Canvas.Top="145" Width="140" Height="140" Stroke="#44FF2A2A" StrokeThickness="0.8" StrokeDashArray="1 5" StrokeDashCap="Round"/>
            <Ellipse Canvas.Left="5" Canvas.Top="155" Width="120" Height="120" Stroke="#22FF2A2A" StrokeThickness="0.5"/>

            <Path Data="{StaticResource BodyGeo}" Stroke="#33FF1E2E" StrokeThickness="7" StrokeLineJoin="Round"/>
            <Path Data="{StaticResource BodyGeo}" Fill="{StaticResource BodyBrush}" Stroke="#FFFF3040" StrokeThickness="1.6" StrokeLineJoin="Round"/>
            <Path Data="{StaticResource BodyGeo}" Stroke="#66FF4A4A" StrokeThickness="0.6" StrokeLineJoin="Round">
                <Path.RenderTransform>
                    <MatrixTransform Matrix="0.88,0,0,0.88,7.8,24.96"/>
                </Path.RenderTransform>
            </Path>

            <Ellipse Canvas.Left="34" Canvas.Top="232" Width="6" Height="6" Stroke="#FFFF4A52" StrokeThickness="0.9"/>
            <Ellipse Canvas.Left="90" Canvas.Top="232" Width="6" Height="6" Stroke="#FFFF4A52" StrokeThickness="0.9"/>

            <Line X1="61.5" Y1="48" X2="57" Y2="256" Stroke="#55FFB0B0" StrokeThickness="0.5"/>
            <Line X1="62.9" Y1="48" X2="60" Y2="256" Stroke="#55FFB0B0" StrokeThickness="0.5"/>
            <Line X1="64.0" Y1="48" X2="63" Y2="256" Stroke="#55FFB0B0" StrokeThickness="0.5"/>
            <Line X1="66.0" Y1="48" X2="67" Y2="256" Stroke="#55FFB0B0" StrokeThickness="0.5"/>
            <Line X1="67.1" Y1="48" X2="70" Y2="256" Stroke="#55FFB0B0" StrokeThickness="0.5"/>
            <Line X1="68.5" Y1="48" X2="73" Y2="256" Stroke="#55FFB0B0" StrokeThickness="0.5"/>

            <Rectangle Canvas.Left="54" Canvas.Top="254" Width="22" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#FFFF3040"/>

            <Polygon Points="60,48 70,48 71.5,176 58.5,176" Fill="#FF14070B" Stroke="#FFFF3040" StrokeThickness="1.2" StrokeLineJoin="Round"/>
            <Path Data="M60.8,60 H69.2 M60.5,72 H69.5 M60.3,83 H69.7 M60.1,94 H69.9 M59.9,104 H70.1 M59.7,113 H70.3 M59.6,122 H70.4 M59.4,130 H70.6 M59.2,138 H70.8 M59.1,145 H70.9 M59,152 H71 M58.9,158 H71.1 M58.7,164 H71.3 M58.6,170 H71.4" Stroke="#AAFF6A6A" StrokeThickness="0.7"/>
            <Ellipse Canvas.Left="64" Canvas.Top="77" Width="2" Height="2" Fill="#FFFF4A52"/>
            <Ellipse Canvas.Left="64" Canvas.Top="98" Width="2" Height="2" Fill="#FFFF4A52"/>
            <Ellipse Canvas.Left="64" Canvas.Top="116" Width="2" Height="2" Fill="#FFFF4A52"/>
            <Ellipse Canvas.Left="64" Canvas.Top="133" Width="2" Height="2" Fill="#FFFF4A52"/>
            <Ellipse Canvas.Left="62.5" Canvas.Top="150" Width="2" Height="2" Fill="#FFFF4A52"/>
            <Ellipse Canvas.Left="65.5" Canvas.Top="150" Width="2" Height="2" Fill="#FFFF4A52"/>

            <Polygon Points="60,48 70,48 71,34 80,20 76,4 65,13 54,4 50,20 59,34" Fill="#FF14070B" Stroke="#FFFF3040" StrokeThickness="1.4" StrokeLineJoin="Round"/>
            <Ellipse Canvas.Left="55.5" Canvas.Top="14.5" Width="3" Height="3" Fill="#FFFF4A52"/>
            <Ellipse Canvas.Left="56.5" Canvas.Top="21" Width="3" Height="3" Fill="#FFFF4A52"/>
            <Ellipse Canvas.Left="57.5" Canvas.Top="27.5" Width="3" Height="3" Fill="#FFFF4A52"/>
            <Ellipse Canvas.Left="71.5" Canvas.Top="14.5" Width="3" Height="3" Fill="#FFFF4A52"/>
            <Ellipse Canvas.Left="70.5" Canvas.Top="21" Width="3" Height="3" Fill="#FFFF4A52"/>
            <Ellipse Canvas.Left="69.5" Canvas.Top="27.5" Width="3" Height="3" Fill="#FFFF4A52"/>
        </Canvas>

        <Style x:Key="EmberA" TargetType="Ellipse">
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="30">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-300" Duration="0:0:8" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:8" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EmberB" TargetType="Ellipse">
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="30" BeginTime="-0:0:4">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-360" Duration="0:0:11" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:11" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EmberC" TargetType="Ellipse">
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="30" BeginTime="-0:0:2">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-240" Duration="0:0:6" RepeatBehavior="Forever"/>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:6" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.55" GradientOrigin="0.5,0.55" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#FF2A060A" Offset="0"/>
                <GradientStop Color="#FF120306" Offset="0.6"/>
                <GradientStop Color="#FF050203" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Rectangle Grid.ColumnSpan="8" Grid.RowSpan="4">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,1.15" GradientOrigin="0.5,1.15" RadiusX="0.8" RadiusY="0.9">
                    <GradientStop Color="#77C0121C" Offset="0"/>
                    <GradientStop Color="#00C0121C" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:4.5" AutoReverse="True" RepeatBehavior="Forever" AccelerationRatio="0.5" DecelerationRatio="0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Rectangle.Triggers>
        </Rectangle>

        <Viewbox Grid.ColumnSpan="8" Grid.RowSpan="4" Stretch="Fill">
            <Canvas Width="1000" Height="500">
                <Canvas Canvas.Left="150" Opacity="0">
                    <Polygon Points="140,0 70,170 115,170 60,330 175,130 125,130 190,0" Fill="#00000000" Stroke="#44FF0000" StrokeThickness="16" StrokeLineJoin="Round"/>
                    <Polygon Points="140,0 70,170 115,170 60,330 175,130 125,130 190,0" Fill="#FFFFE6E6" Stroke="#FFFF2A2A" StrokeThickness="3" StrokeLineJoin="Round"/>
                    <Canvas.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:7" RepeatBehavior="Forever">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:5" Value="1"/>
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:5.1" Value="0"/>
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:5.22" Value="0.8"/>
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:5.4" Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Canvas.Triggers>
                </Canvas>
                <Canvas Canvas.Left="590" Opacity="0">
                    <Polygon Points="140,0 70,170 115,170 60,330 175,130 125,130 190,0" Fill="#00000000" Stroke="#44FF0000" StrokeThickness="16" StrokeLineJoin="Round"/>
                    <Polygon Points="140,0 70,170 115,170 60,330 175,130 125,130 190,0" Fill="#FFFFE6E6" Stroke="#FFFF2A2A" StrokeThickness="3" StrokeLineJoin="Round"/>
                    <Canvas.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:9" RepeatBehavior="Forever">
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:3.5" Value="1"/>
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:3.6" Value="0"/>
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:3.75" Value="0.7"/>
                                        <DiscreteDoubleKeyFrame KeyTime="0:0:3.9" Value="0"/>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Canvas.Triggers>
                </Canvas>

                <Ellipse Canvas.Left="120" Canvas.Top="470" Width="5" Height="5" Fill="#FFFF5A1E" Style="{StaticResource EmberA}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="230" Canvas.Top="480" Width="4" Height="4" Fill="#FFFF8A2E" Style="{StaticResource EmberB}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="340" Canvas.Top="475" Width="5" Height="5" Fill="#FFFF5A1E" Style="{StaticResource EmberC}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="520" Canvas.Top="485" Width="4" Height="4" Fill="#FFFF8A2E" Style="{StaticResource EmberA}" Opacity="0.4">
                    <Ellipse.RenderTransform>
                        <TranslateTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="680" Canvas.Top="478" Width="5" Height="5" Fill="#FFFF5A1E" Style="{StaticResource EmberB}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="790" Canvas.Top="470" Width="4" Height="4" Fill="#FFFF8A2E" Style="{StaticResource EmberC}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Canvas.Left="890" Canvas.Top="482" Width="5" Height="5" Fill="#FFFF5A1E" Style="{StaticResource EmberA}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Viewbox>

        <Viewbox Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="4" Stretch="Uniform" Margin="6" Opacity="0.7">
            <ContentControl Content="{StaticResource GuitarArt}" RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform>
                    <RotateTransform Angle="-16"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Viewbox>
        <Viewbox Grid.Column="6" Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="4" Stretch="Uniform" Margin="6" Opacity="0.7">
            <ContentControl Content="{StaticResource GuitarArt}" RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform>
                    <RotateTransform Angle="16"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Viewbox>

        <Rectangle Grid.ColumnSpan="8" Grid.RowSpan="4" Fill="#30FF2020" Opacity="0" IsHitTestVisible="False">
            <Rectangle.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:7" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:5" Value="1"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:5.1" Value="0"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:5.22" Value="0.8"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:5.4" Value="0"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Rectangle.Triggers>
        </Rectangle>
    </Grid>
</UserControl>