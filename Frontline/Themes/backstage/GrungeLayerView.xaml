<UserControl x:Class="FrontLineOverlay.GrungeLayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             mc:Ignorable="po"
             IsHitTestVisible="False">
    <UserControl.Resources>
        <DrawingBrush x:Key="Hazard" TileMode="Tile" ViewboxUnits="Absolute" Viewbox="0,0,16,16" ViewportUnits="Absolute" Viewport="0,0,16,16" po:Freeze="True">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFE1AD01" Geometry="M0,0 H16 V16 H0 Z"/>
                    <GeometryDrawing Brush="#FF141414" Geometry="M8,0 H16 L0,16 V8 Z M16,8 V16 H8 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="Dust" TileMode="Tile" ViewboxUnits="Absolute" Viewbox="0,0,200,200" ViewportUnits="Absolute" Viewport="0,0,200,200" po:Freeze="True">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#22FFFFFF" Geometry="M20,30 h2 v2 h-2 Z M150,50 h1.5 v1.5 h-1.5 Z M80,120 h2 v2 h-2 Z M170,170 h2 v1.5 h-2 Z M40,180 h1.5 v2 h-1.5 Z"/>
                    <GeometryDrawing Geometry="M10,60 L90,70 M120,150 L190,138 M60,190 L120,184">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1CFFFFFF" Thickness="0.7"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid IsHitTestVisible="False" ClipToBounds="True">
        <Rectangle Fill="{StaticResource Dust}" IsHitTestVisible="False"/>

        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush RadiusX="0.75" RadiusY="0.8">
                    <GradientStop Color="#00000000" Offset="0.5"/>
                    <GradientStop Color="#AA000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:6" RepeatBehavior="Forever">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="0.7"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:3.1" Value="1"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:3.3" Value="0.8"/>
                                <DiscreteDoubleKeyFrame KeyTime="0:0:3.4" Value="1"/>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Rectangle.Triggers>
        </Rectangle>

        <Rectangle Margin="6" Stroke="#66E1AD01" StrokeThickness="2" StrokeDashArray="10,6,3,6" Fill="Transparent" IsHitTestVisible="False"/>

    </Grid>
</UserControl>