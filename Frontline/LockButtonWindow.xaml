<Window x:Class="FrontLineOverlay.LockButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" Width="40" Height="40">
    <Grid x:Name="Hit" Background="Transparent" Cursor="Hand"
          MouseEnter="Hit_MouseEnter" MouseLeave="Hit_MouseLeave"
          MouseLeftButtonUp="Hit_MouseLeftButtonUp">
        <Border x:Name="Pad" Width="28" Height="28" Opacity="0.25"
                Background="#44000000" BorderBrush="#33FFFFFF"
                BorderThickness="1" CornerRadius="6">
            <Rectangle x:Name="Icon" Width="14" Height="14"/>
        </Border>
    </Grid>
</Window>