<Window x:Class="FrontLineOverlay.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FrontLine Lyrics" Width="560" Height="490"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="False"
        Background="#FF141418" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" SnapsToDevicePixels="True" UseLayoutRounding="True" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Remove chrome nativo extra sem voltar à janela em camadas. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/Common.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/Toggles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/ScrollBars.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="0" Background="#FF141418" BorderBrush="#3AFFFFFF" BorderThickness="1" CornerRadius="16">
        <Grid Margin="26,20,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" x:Name="LangPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                <ToggleButton Content="EN" Tag="en" Width="40" Height="26" FontSize="10" Margin="2,0" Style="{DynamicResource SquareGlassToggle}" Click="Lang_Click"/>
                <ToggleButton Content="PT" Tag="pt" Width="40" Height="26" FontSize="10" Margin="2,0" Style="{DynamicResource SquareGlassToggle}" Click="Lang_Click"/>
                <ToggleButton Content="ES" Tag="es" Width="40" Height="26" FontSize="10" Margin="2,0" Style="{DynamicResource SquareGlassToggle}" Click="Lang_Click"/>
                <ToggleButton Content="ID" Tag="id" Width="40" Height="26" FontSize="10" Margin="2,0" Style="{DynamicResource SquareGlassToggle}" Click="Lang_Click"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock x:Name="TxtTitle" FontSize="22" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtVersion" FontSize="12.5" Foreground="#FF8AB4FF" FontWeight="SemiBold" Margin="0,7,0,0"/>
                <TextBlock x:Name="TxtDescription" FontSize="13" Foreground="#E6FFFFFF" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                <Border Padding="16,14" CornerRadius="10" Background="#0DFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="TxtChangesTitle" FontSize="11" FontWeight="Bold" Foreground="#99FFFFFF" Margin="0,0,0,9"/>
                        <StackPanel x:Name="PanelChanges"/>
                        <TextBlock x:Name="TxtFullRelease" Margin="6,12,0,1" FontSize="12.5" TextWrapping="Wrap"
                                   Visibility="Collapsed">
                            <Hyperlink x:Name="LinkFullRelease" Foreground="#FF8AB4FF"
                                       TextDecorations="Underline" Click="LinkFullRelease_Click"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <Button Grid.Row="3" x:Name="BtnDone" IsDefault="True" HorizontalAlignment="Right"
                    MinWidth="130" Height="36" Margin="0,16,0,0" Padding="16,6" FontSize="13"
                    Style="{DynamicResource FestivalGlassButton}" Click="BtnDone_Click"/>
        </Grid>
    </Border>
</Window>
