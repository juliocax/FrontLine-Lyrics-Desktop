<Window x:Class="FrontLineOverlay.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FrontLine Lyrics" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False"
        Background="#FF141418" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" SnapsToDevicePixels="True" UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Remove chrome nativo extra sem voltar à janela em camadas. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/Common.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/Toggles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/ScrollBars.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="0" Background="#FF141418" BorderBrush="#3AFFFFFF" BorderThickness="1" CornerRadius="16">

        <Grid Margin="26,20,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" x:Name="LangPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                <ToggleButton Content="EN" Tag="en" Width="40" Height="26" FontSize="10" Margin="2,0" Style="{DynamicResource SquareGlassToggle}" Click="Lang_Click"/>
                <ToggleButton Content="PT" Tag="pt" Width="40" Height="26" FontSize="10" Margin="2,0" Style="{DynamicResource SquareGlassToggle}" Click="Lang_Click"/>
                <ToggleButton Content="ES" Tag="es" Width="40" Height="26" FontSize="10" Margin="2,0" Style="{DynamicResource SquareGlassToggle}" Click="Lang_Click"/>
                <ToggleButton Content="ID" Tag="id" Width="40" Height="26" FontSize="10" Margin="2,0" Style="{DynamicResource SquareGlassToggle}" Click="Lang_Click"/>
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="TxtTitle" FontSize="22" FontWeight="Bold" Foreground="White"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <StackPanel Margin="0,0,8,0">

                    <TextBlock x:Name="TxtThanks" FontSize="13.5" Foreground="#E6FFFFFF" TextWrapping="Wrap" LineHeight="20"/>

                    <TextBlock x:Name="TxtTutorials" FontSize="13.5" Foreground="#E6FFFFFF" TextWrapping="Wrap" Margin="0,10,0,0">
                        <Run x:Name="RunTutorialsLead"/><Hyperlink x:Name="LinkTutorials" Foreground="#FF8AB4FF" Click="LinkTutorials_Click"><Run x:Name="RunTutorialsLink"/></Hyperlink>
                    </TextBlock>

                    <Border Margin="0,18,0,0" Padding="16,14" CornerRadius="10" Background="#0DFFFFFF"
                            BorderBrush="#22FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="TxtTelHeader" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="TxtTelIntro" FontSize="12.5" Foreground="#CCFFFFFF" TextWrapping="Wrap" Margin="0,6,0,0"/>

                            <TextBlock x:Name="TxtSentLabel" FontSize="11" FontWeight="Bold" Foreground="#99FFFFFF" Margin="0,12,0,2"/>
                            <StackPanel x:Name="PanelSent"/>

                            <TextBlock x:Name="TxtNeverSent" FontSize="12.5" Foreground="#FFB5E8C0" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <TextBlock x:Name="TxtProvider" FontSize="12" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock FontSize="11.5" Foreground="#99FFFFFF" TextWrapping="Wrap" Margin="0,12,0,0">
                        <Hyperlink x:Name="LinkSource" Foreground="#FF8AB4FF" Click="LinkSource_Click"><Run x:Name="RunSourceLink"/></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtToggle" FontSize="13" Foreground="White" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ToggleButton x:Name="ToggleTelemetry" Grid.Column="1" IsChecked="True"
                                  Style="{DynamicResource ToggleSwitchNoLabelStyle}" VerticalAlignment="Center"/>
                </Grid>
                <Button x:Name="BtnStart" IsDefault="True" HorizontalAlignment="Right" MinWidth="130" Height="36"
                        Margin="0,16,0,0" Padding="16,6" FontSize="13"
                        Style="{DynamicResource FestivalGlassButton}" Click="BtnStart_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
